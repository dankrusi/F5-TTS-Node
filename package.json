{
  "name": "f5-tts-node",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Local English and German F5-TTS voice generation in Node.js using native ONNX Runtime",
  "repository": {
    "type": "git",
    "url": "https://github.com/dankrusi/F5-TTS-Node.git"
  },
  "homepage": "https://github.com/dankrusi/F5-TTS-Node#readme",
  "bugs": {
    "url": "https://github.com/dankrusi/F5-TTS-Node/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./references/*": "./examples/references/*",
    "./models.json": "./dist/models.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "f5-tts-node": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "demo": "node examples/news.mjs",
    "prepack": "pnpm run build"
  },
  "license": "MIT",
  "dependencies": {
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
